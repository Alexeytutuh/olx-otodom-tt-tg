# /opt/tiktok-connect/.env   (chmod 600, owner root) — NEVER commit or paste anywhere
# Use the client key/secret of the SANDBOX "test" while testing in sandbox
# (Sandbox credentials differ from Production ones).
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
PUBLIC_BASE_URL=https://media.example.com
REDIRECT_URI=https://media.example.com/tiktok/callback
# optional
# LOG_LEVEL=INFO
# MEDIA_RETENTION_DAYS=14
# REFRESH_MARGIN_SECONDS=3600
# shared secret for the bot -> POST /internal/draft (same value as TIKTOK_CONNECT_TOKEN in the bot's .env)
INTERNAL_TOKEN=
# operator shown on /privacy and /terms (TikTok requires real details in production)
PAGES_OPERATOR=Your Name
PAGES_OPERATOR_UK=Ваше Ім'я
PAGES_CONTACT=contact@example.com
# PAGES_APP_NAME=Listing Publisher
