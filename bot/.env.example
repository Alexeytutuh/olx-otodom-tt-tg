# Copy to .env (chmod 600). Only TELEGRAM_BOT_TOKEN is required.
TELEGRAM_BOT_TOKEN=123456789:AA...your-token-from-BotFather

# Who may use the bot. Empty = the first person who sends /start becomes the owner (posts go there).
# Comma separated numeric chat ids, e.g. the friend's and yours.
ALLOWED_CHAT_IDS=
# Optional: fix the owner chat instead of "first /start".
OWNER_CHAT_ID=
# Where technical alerts go ("OLX відвалився ..."). Empty = owner chat.
ALERT_CHAT_ID=

# Schedule: every 300 s, aligned to :00, :05, :10 ... Do not go below 120.
POLL_INTERVAL_S=300
SOURCES=olx,otodom
# Alert after N failed checks in a row (3 x 5 min = 15 min); repeat the alert every N hours while down.
ALERT_AFTER_FAILURES=3
REALERT_HOURS=6
# Internal watchdog: no progress for this long -> exit -> Docker restarts the container.
HANG_TIMEOUT_S=900
# Max posts per source per 5-min run (the rest go in the next run).
MAX_POSTS_PER_RUN=15
SEEN_KEEP_DAYS=30
STARTUP_SUMMARY=true
LOG_LEVEL=INFO

# Contact lines added at the end of every post (bot chat, channel, TikTok). "\n" = new line.
POST_FOOTER=Szczegóły na zapytanie\nZapraszam do kontaktu\nImię Nazwisko\nFIRMA\n☎️ +48 000 000 000

# "📢 В канал" button: the bot must be an admin of the channel. -100... id or @username. Empty = no button.
TELEGRAM_CHANNEL_ID=

# "🎵 В чернетки TikTok" button through the tiktok-connect service (same docker network).
# TIKTOK_CONNECT_TOKEN = INTERNAL_TOKEN from /opt/tiktok-connect/.env
TIKTOK_CONNECT_ENABLED=false
TIKTOK_CONNECT_URL=http://tiktok-connect:8090
TIKTOK_CONNECT_TOKEN=

# Tests only (fake Telegram server); never set in production.
# TELEGRAM_API_BASE=http://127.0.0.1:8081
